{
  "name": "nano-infer",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/nvidia-cuda:1": {
      "installCudaToolkit": true,
      "cudaVersion": "12.6"
    }
  },
  "postCreateCommand": "pip install --index-url https://download.pytorch.org/whl/cpu torch && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "nvidia.nsight-vscode-edition"
      ]
    }
  }
}
